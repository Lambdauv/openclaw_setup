[Unit]
Description=Periodic OpenClaw post-upgrade patch check (detects upgrade-clobbered patches)

[Timer]
# 2026-10-13: OnCalendar, not OnUnitActiveSec — the latter stops rescheduling once its service stops (CLAUDE.md, loop-liveness).
OnBootSec=3min
OnCalendar=*:0/30
Persistent=true

[Install]
WantedBy=timers.target
